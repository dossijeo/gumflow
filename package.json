{
  "name": "gumflow",
  "version": "6.1.2",
  "private": true,
  "description": "GUMFLOW 6.1 gameplay with additive gamepad support and Tauri desktop packaging",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-standalone.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:release": "node scripts/build-release.mjs",
    "verify:baseline": "node scripts/verify-baseline.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:install": "npm install --prefix desktop/tauri",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "desktop:info": "node scripts/desktop.mjs info",
    "verify:core": "node scripts/verify-core.mjs",
    "release:check": "node scripts/release.mjs check",
    "test:browser": "python tests/browser_smoke.py",
    "test:gamepad": "python tests/browser_gamepad.py",
    "version:set": "node scripts/set-version.mjs",
    "test:audio-startup": "python tests/browser_audio_startup.py",
    "test:linux": "python3 tests/linux_appimage_smoke.py --appimage desktop/tauri/src-tauri/target/release/bundle/appimage"
  }
}
